# Server Configuration
PORT=3000
NODE_ENV=development
APP_BASE_URL=https://your-domain-or-ngrok-url.com

# Database Configuration (PostgreSQL in production, SQLite can be used for dev/testing)
DATABASE_URL="file:./dev.db"

# JWT Secret for Admin Panel Authentication
JWT_SECRET=your_jwt_secret_change_in_production_min_32_chars

# Business Configuration
DEFAULT_CONSULTATION_FEE=1500

# WhatsApp Cloud API Credentials
WHATSAPP_VERIFY_TOKEN=your_whatsapp_verify_token
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_APP_SECRET=your_whatsapp_app_secret

# PhonePe Gateway Credentials
PHONEPE_MERCHANT_ID=your_phonepe_merchant_id
PHONEPE_SALT_KEY=your_phonepe_salt_key
PHONEPE_SALT_INDEX=1
PHONEPE_HOST_URL=https://api-preprod.phonepe.com/apis/pg-sandbox
PHONEPE_REDIRECT_URL=https://your-domain-or-ngrok-url.com/payment/redirect
PHONEPE_CALLBACK_URL=https://your-domain-or-ngrok-url.com/webhook/phonepe
PHONEPE_UPI_ID=aadiyogi.rises@ybl
